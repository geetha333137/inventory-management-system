@model InventoryManagementSystem.Models.Category

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <p class="text-uppercase text-secondary mb-1">Category</p>
        <h2 class="fw-semibold mb-1">@Model.Name</h2>
        <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning" title="Edit category" aria-label="Edit category">
            <i class="bi bi-pencil"></i>
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to categories</a>
    </div>
</div>

<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">Assets in this category</h5>
            <small class="text-muted">@Model.Assets.Count asset(s)</small>
        </div>
        <a asp-controller="Asset" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add asset
        </a>
    </div>

    @if (Model.Assets.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Asset code</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var asset in Model.Assets.OrderBy(a => a.AssetName))
                {
                    <tr>
                        <td class="fw-semibold">@asset.AssetCode</td>
                        <td>@asset.AssetName</td>
                        <td><partial name="_AssetStatusBadge" model="asset.Status" /></td>
                        <td>@(string.IsNullOrWhiteSpace(asset.Location) ? "-" : asset.Location)</td>
                        <td class="text-end">
                            <a asp-controller="Asset" asp-action="Details" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary" title="View asset" aria-label="View asset">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-box-seam fs-1"></i>
            <h5 class="mt-3">No assets in this category</h5>
            <p>Add an asset and assign it to this category to see it here.</p>
        </div>
    }
</div>
