@model List<Category>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-semibold mb-1">Category Management</h2>
        <p class="text-muted mb-0">Browse and search asset categories used by the inventory.</p>
    </div>
    @if (User.IsInRole("Asset Manager"))
    {
        <a asp-action="Create" class="btn btn-primary">Add Category</a>
    }
</div>

<form asp-action="Index" method="get" class="panel mb-4">
    <label for="categorySearch" class="form-label fw-semibold">Search categories</label>
    <div class="input-group">
        <input id="categorySearch" name="search" value="@ViewBag.Search" class="form-control" placeholder="Category name or description" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1">Categories</h5>
            <small class="text-muted">@Model.Count category(s) registered</small>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Assets</th>
                        <th>Status</th>
                        <th class="text-end">@(User.IsInRole("Asset Manager") ? "Actions" : "Details")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-action="Details" asp-route-id="@category.Id">@category.Name</a>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(category.Description) ? "No description" : category.Description)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@category.Id" class="text-decoration-none">
                                @category.Assets.Count
                            </a>
                        </td>
                        <td>
                            @if (category.IsActive)
                            {
                                <span class="status-badge badge-available">Active</span>
                            }
                            else
                            {
                                <span class="status-badge badge-retired">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border action-btn dropdown-toggle no-caret"
                                        type="button"
                                        id="catMenu_@category.Id"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        title="Action menu"
                                        style="padding: 0.35rem 0.55rem; border-radius: 8px; line-height: 1;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                                    </svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" aria-labelledby="catMenu_@category.Id" style="border-radius: 10px; font-size: 0.875rem; min-width: 150px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -6px rgba(0,0,0,0.04) !important;">
                                    <li>
                                        <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@category.Id">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            Details
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Asset Manager") || User.IsInRole("Inventory Executive"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@category.Id">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                                Edit
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Asset Manager") || User.IsInRole("Inventory Executive"))
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2 text-danger" asp-action="Delete" asp-route-id="@category.Id">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                                Delete
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <h5>No Categories Found</h5>
            <p>No categories match your search.</p>
            @if (User.IsInRole("Asset Manager"))
            {
                <a asp-action="Create" class="btn btn-primary">Add First Category</a>
            }
        </div>
    }
</div>
