@model Category

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-semibold mb-1">Add New Category</h2>
        <p class="text-muted mb-0">Create a category for organising inventory assets.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Categories</a>
</div>

<form asp-action="Create" method="post">
    <div class="form-section">
        <div class="form-section-title">Category Information</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <span class="text-danger">*</span>
                <input asp-for="Name" class="form-control" placeholder="Example: Laptop" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active category</label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label fw-semibold"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the type of assets included in this category..."></textarea>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Category</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
