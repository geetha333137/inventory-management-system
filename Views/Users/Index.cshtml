@model List<InventoryManagementSystem.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-4 p-md-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <p class="text-uppercase text-muted fw-semibold small mb-1 tracking-wider">Administration</p>
                <h1 class="h3 fw-bold text-dark mb-1">User Management</h1>
                <p class="text-muted mb-0 small">Manage system user accounts, roles, access permissions, and account statuses.</p>
            </div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 rounded-2 d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
                <span>Create User</span>
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Index" method="get" class="mb-4">
            <div class="input-group search-bar-modern">
                <span class="input-group-text bg-white border-end-0 text-muted ps-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search username, name or email..." />
                <button type="submit" class="btn btn-secondary px-4">Search</button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 py-3">Username</th>
                        <th class="py-3">Full Name</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Phone</th>
                        <th class="py-3">Role</th>
                        <th class="py-3">Status</th>
                        <th class="py-3">Created</th>
                        <th class="pe-3 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="mb-2">👤</div>
                                No users found matching your search.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">@user.Username</td>
                                <td class="fw-semibold text-secondary">@user.FullName</td>
                                <td>@user.Email</td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                                <td>
                                    @if (user.Role?.Name == "Asset Manager")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">Asset Manager</span>
                                    }
                                    else if (user.Role?.Name == "Inventory Executive")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 rounded-pill">Inventory Executive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">User</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">Inactive</span>
                                    }
                                </td>
                                <td class="text-muted small">@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td class="pe-3 text-end">
                                    <!-- 3-line hamburger menu dropdown button -->
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border action-btn dropdown-toggle no-caret"
                                                type="button"
                                                id="userMenu_@user.Id"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="Action menu"
                                                style="padding: 0.35rem 0.55rem; border-radius: 8px; line-height: 1;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                                <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                                            </svg>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" aria-labelledby="userMenu_@user.Id" style="border-radius: 10px; font-size: 0.875rem; min-width: 150px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -6px rgba(0,0,0,0.04) !important;">
                                            <li>
                                                <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@user.Id">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                    </svg>
                                                    View Details
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@user.Id">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    Edit User
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider my-1"></li>
                                            <li>
                                                <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    @if (user.IsActive)
                                                    {
                                                        <button type="submit" class="dropdown-item py-1 px-3 d-flex align-items-center gap-2 text-danger">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                            </svg>
                                                            Deactivate
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="dropdown-item py-1 px-3 d-flex align-items-center gap-2 text-success">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                            </svg>
                                                            Activate
                                                        </button>
                                                    }
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
