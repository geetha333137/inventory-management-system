@model List<Asset>

@{
    int totalAssets = ViewBag.TotalAssets ?? 0;
    int availableAssets = ViewBag.AvailableAssets ?? 0;
    int assignedAssets = ViewBag.AssignedAssets ?? 0;
    int maintenanceAssets = ViewBag.MaintenanceAssets ?? 0;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var locations = ViewBag.Locations as List<string> ?? new List<string>();
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var assignedUsers = ViewBag.AssignedUsers as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Asset Inventory</h2>
        <p class="text-muted mb-0">View and search all organisation assets.</p>
    </div>
    @if (User.IsInRole("Asset Manager"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add New Asset
        </a>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="kpi-card teal"><div class="kpi-label">Total</div><div class="kpi-value">@totalAssets</div></div></div>
    <div class="col-md-3"><div class="kpi-card green"><div class="kpi-label">Available</div><div class="kpi-value">@availableAssets</div></div></div>
    <div class="col-md-3"><div class="kpi-card blue"><div class="kpi-label">Assigned</div><div class="kpi-value">@assignedAssets</div></div></div>
    <div class="col-md-3"><div class="kpi-card amber"><div class="kpi-label">Maintenance</div><div class="kpi-value">@maintenanceAssets</div></div></div>
</div>

<div class="panel mb-4">
    <h5 class="fw-bold mb-3">Search & Filter</h5>
    <form asp-action="Index" method="get">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                       placeholder="Code, name, serial, location or assigned user" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    @foreach (var status in AssetStatuses.All)
                    {
                        if (ViewBag.Status == status)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Category</label>
                <select name="category" class="form-select">
                    <option value="">All</option>
                    @foreach (var category in categories)
                    {
                        if (ViewBag.Category == category.Name)
                        {
                            <option value="@category.Name" selected>@category.Name</option>
                        }
                        else
                        {
                            <option value="@category.Name">@category.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Location</label>
                <select name="location" class="form-select">
                    <option value="">All</option>
                    @foreach (var location in locations)
                    {
                        if (ViewBag.Location == location)
                        {
                            <option value="@location" selected>@location</option>
                        }
                        else
                        {
                            <option value="@location">@location</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Department</label>
                <select name="department" class="form-select">
                    <option value="">All</option>
                    @foreach (var department in departments)
                    {
                        if (ViewBag.Department == department)
                        {
                            <option value="@department" selected>@department</option>
                        }
                        else
                        {
                            <option value="@department">@department</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Assigned User</label>
                <select name="assignedTo" class="form-select">
                    <option value="">All</option>
                    @foreach (var person in assignedUsers)
                    {
                        if (ViewBag.AssignedTo == person)
                        {
                            <option value="@person" selected>@person</option>
                        }
                        else
                        {
                            <option value="@person">@person</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Clear</a>
        </div>
    </form>
</div>

<div class="panel">
    <div class="d-flex justify-content-between mb-3">
        <div>
            <h5 class="fw-bold mb-1">Asset List</h5>
            <small class="text-muted">Showing @Model.Count asset(s)</small>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Asset Code</th>
                        <th>Asset Name</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Last Updated</th>
                        <th class="text-end">@(User.IsInRole("Asset Manager") ? "Actions" : "Details")</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var asset in Model)
                {
                    <tr>
                        <td class="fw-semibold">@asset.AssetCode</td>
                        <td>@asset.AssetName</td>
                        <td>@(asset.Category?.Name ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(asset.Location) ? "—" : asset.Location)</td>
                        <td><partial name="_AssetStatusBadge" model="asset.Status" /></td>
                        <td>@(string.IsNullOrWhiteSpace(asset.AssignedTo) ? "Not assigned" : asset.AssignedTo)</td>
                        <td>@((asset.UpdatedDate ?? asset.CreatedDate).ToLocalTime().ToString("dd MMM yyyy"))</td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border action-btn dropdown-toggle no-caret"
                                        type="button"
                                        id="assetMenu_@asset.Id"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        title="Action menu"
                                        style="padding: 0.35rem 0.55rem; border-radius: 8px; line-height: 1;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                                    </svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" aria-labelledby="assetMenu_@asset.Id" style="border-radius: 10px; font-size: 0.875rem; min-width: 150px; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -6px rgba(0,0,0,0.04) !important;">
                                    <li>
                                        <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2" asp-action="Details" asp-route-id="@asset.Id">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            Details
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Asset Manager") || User.IsInRole("Inventory Executive"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2" asp-action="Edit" asp-route-id="@asset.Id">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                                Edit
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole("Asset Manager") || User.IsInRole("Inventory Executive"))
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item py-1 px-3 d-flex align-items-center gap-2 text-danger" asp-action="Delete" asp-route-id="@asset.Id">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                                Delete
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="fs-1">📦</div>
            <h5 class="mt-3">No Assets Found</h5>
            <p>There are no assets matching your search or filter criteria.</p>
            @if (User.IsInRole("Asset Manager"))
            {
                <a asp-action="Create" class="btn btn-primary">Add First Asset</a>
            }
        </div>
    }
</div>
