@model Asset

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="form-section">
    <div class="form-section-title">Asset Information</div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="AssetCode" class="form-label fw-semibold"></label>
            <span class="text-danger">*</span>
            <input asp-for="AssetCode" class="form-control" placeholder="Example: AST-000123" />
            <div class="form-text">Must be unique across the inventory.</div>
            <span asp-validation-for="AssetCode" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AssetName" class="form-label fw-semibold"></label>
            <span class="text-danger">*</span>
            <input asp-for="AssetName" class="form-control" placeholder="Example: Dell Latitude 5440" />
            <span asp-validation-for="AssetName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CategoryId" class="form-label fw-semibold"></label>
            <span class="text-danger">*</span>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- Select Category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="SerialNumber" class="form-label fw-semibold"></label>
            <input asp-for="SerialNumber" class="form-control" placeholder="Optional serial number" />
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">Purchase Information</div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="PurchaseDate" class="form-label fw-semibold"></label>
            <input asp-for="PurchaseDate" type="date" class="form-control" />
            <span asp-validation-for="PurchaseDate" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PurchaseCost" class="form-label fw-semibold"></label>
            <div class="input-group">
                <span class="input-group-text">₹</span>
                <input asp-for="PurchaseCost" type="number" step="0.01" min="0" class="form-control" placeholder="65000" />
            </div>
            <span asp-validation-for="PurchaseCost" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">Location & Assignment</div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Location" class="form-label fw-semibold"></label>
            <input asp-for="Location" class="form-control" placeholder="Example: Hyderabad Office" />
        </div>
        <div class="col-md-6">
            <label asp-for="Department" class="form-label fw-semibold"></label>
            <input asp-for="Department" class="form-control" placeholder="Example: Information Technology" />
        </div>
        <div class="col-md-6">
            <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
            <input asp-for="AssignedTo" class="form-control" placeholder="Employee or team name" />
            <div class="form-text">Required when status is Assigned. User lookup will connect later with User Management.</div>
            <span asp-validation-for="AssignedTo" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Status" class="form-label fw-semibold"></label>
            <span class="text-danger">*</span>
            <select asp-for="Status" class="form-select">
                <option value="">Select asset status</option>
                @foreach (var status in AssetStatuses.All)
                {
                    <option value="@status">@status</option>
                }
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">Additional Information</div>
    <label asp-for="Description" class="form-label fw-semibold"></label>
    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter additional information about the asset..."></textarea>
</div>
