@model Asset

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-semibold mb-1">Add New Asset</h2>
        <p class="text-muted mb-0">Register a new asset in the inventory system.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Inventory</a>
</div>

<form asp-action="Create" method="post">
    <partial name="_AssetForm" model="Model" />
    <div class="d-flex justify-content-end gap-2 mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">Save Asset</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
