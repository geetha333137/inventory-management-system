@model InventoryManagementSystem.ViewModels.AssetTrackingViewModel

@{
    ViewData["Title"] = "Asset Tracking";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <p class="dashboard-eyebrow">Workspace</p>
        <h2 class="fw-bold mb-1">Asset Tracking</h2>
        <p class="text-muted mb-0">Monitor where assets are, who uses them, and what changed.</p>
    </div>
</div>

@if (Model.Assets.Any())
{
    <div class="row g-3">
        @foreach (var asset in Model.Assets)
        {
            <div class="col-12">
                <div class="dashboard-panel">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <p class="dashboard-eyebrow mb-1">@asset.AssetCode</p>
                            <h5>@asset.AssetName</h5>
                        </div>
                        <partial name="_AssetStatusBadge" model="asset.Status" />
                    </div>

                    <div class="detail-list mb-0">
                        <div class="detail-item">
                            <span class="detail-label">Current Location</span>
                            <strong>@asset.Location</strong>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Assigned User</span>
                            <strong>@asset.AssignedUser</strong>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Department</span>
                            <strong>@asset.Department</strong>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Last Updated</span>
                            <strong>@asset.LastUpdated.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong>
                        </div>
                    </div>

                    @if (asset.History.Any())
                    {
                        <div class="mt-4">
                            <h6 class="fw-bold">Tracking History</h6>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Action</th>
                                            <th>Description</th>
                                            <th>Performed By</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var entry in asset.History)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@entry.Action</td>
                                            <td>@entry.Description</td>
                                            <td>@(entry.PerformedBy ?? "System")</td>
                                            <td>@entry.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="dashboard-panel empty-state">No assets are available for tracking.</div>
}