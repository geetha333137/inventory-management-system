@model InventoryManagementSystem.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "User Dashboard";
}

<div class="user-dashboard">
    <!-- HERO / WELCOME CARD -->
    <div class="card border-0 shadow-sm mb-4 rounded-3 bg-white">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="user-avatar-lg">
                        @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="h4 fw-bold text-dark mb-0">Welcome back, @Model.FullName</h2>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                @Model.RoleName
                            </span>
                        </div>
                        <p class="text-muted mb-0 small">
                            Department: <strong class="text-secondary">@Model.Department</strong> &bull; Employee ID: <strong class="text-secondary">@Model.EmployeeId</strong> &bull; Email: <strong class="text-secondary">@Model.Email</strong>
                        </p>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Asset" asp-action="Index" class="btn btn-outline-primary btn-sm px-3 py-2 rounded-2 d-inline-flex align-items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        Browse Assets
                    </a>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-light border btn-sm px-3 py-2 rounded-2 d-inline-flex align-items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        My Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT METRIC CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 kpi-modern">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box bg-primary-subtle text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small tracking-wider">My Assigned Assets</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TotalAssignedAssets</div>
                        <small class="text-muted">Assigned to you</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 kpi-modern">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box bg-success-subtle text-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small tracking-wider">Available Assets</div>
                        <div class="fs-3 fw-bold text-dark">@Model.AvailableAssetsCount</div>
                        <small class="text-muted">In company inventory</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 kpi-modern">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box bg-info-subtle text-info">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small tracking-wider">Asset Categories</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TotalCategoriesCount</div>
                        <small class="text-muted">Hardware & equipment</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 rounded-3 kpi-modern">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="kpi-icon-box bg-secondary-subtle text-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <div>
                        <div class="text-uppercase text-muted fw-semibold small tracking-wider">Account Status</div>
                        <div class="fs-4 fw-bold text-success mt-1">Verified Active</div>
                        <small class="text-muted">Standard User Access</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MY ASSIGNED ASSETS TABLE -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom border-light-subtle py-3 px-4 d-flex align-items-center justify-content-between">
            <div>
                <h3 class="h5 fw-bold text-dark mb-0">My Assigned Assets</h3>
                <small class="text-muted">Equipment and hardware registered to your account</small>
            </div>
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                @Model.AssignedAssets.Count Items
            </span>
        </div>
        <div class="card-body p-0">
            @if (Model.AssignedAssets.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3">Asset Code</th>
                                <th class="py-3">Asset Name</th>
                                <th class="py-3">Category</th>
                                <th class="py-3">Serial Number</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Location</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in Model.AssignedAssets)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">@asset.AssetCode</td>
                                    <td class="fw-semibold text-dark">@asset.AssetName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(asset.Category?.Name ?? "General")
                                        </span>
                                    </td>
                                    <td class="text-secondary small">@(string.IsNullOrWhiteSpace(asset.SerialNumber) ? "—" : asset.SerialNumber)</td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                            @asset.Status
                                        </span>
                                    </td>
                                    <td class="text-secondary small">@(asset.Location ?? "Office")</td>
                                    <td class="pe-4 text-end">
                                        <a asp-controller="Asset" asp-action="Details" asp-route-id="@asset.Id" class="btn btn-sm btn-outline-primary px-3 rounded-2">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-4">
                    <div class="mb-3 text-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                    </div>
                    <h5 class="fw-bold text-dark">No Equipment Currently Assigned</h5>
                    <p class="text-muted mx-auto" style="max-width: 420px;">
                        You do not have any company devices or inventory items assigned to your account right now. You can explore available equipment in the catalog.
                    </p>
                    <a asp-controller="Asset" asp-action="Index" class="btn btn-primary btn-sm px-3 rounded-2">
                        Browse Available Assets
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- TWO COLUMN LAYOUT: COMPANY AVAILABLE ASSETS & PROFILE SUMMARY -->
    <div class="row g-4">
        <!-- AVAILABLE ASSETS -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom border-light-subtle py-3 px-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-0">Company Equipment Catalog</h4>
                        <small class="text-muted">Available hardware ready for assignment</small>
                    </div>
                    <a asp-controller="Asset" asp-action="Index" class="btn btn-link text-primary btn-sm p-0 text-decoration-none fw-semibold">
                        View All &rarr;
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Code</th>
                                    <th>Equipment</th>
                                    <th>Category</th>
                                    <th>Location</th>
                                    <th class="pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in Model.RecentAvailableAssets)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-secondary small">@asset.AssetCode</td>
                                        <td class="fw-semibold text-dark">@asset.AssetName</td>
                                        <td><span class="badge bg-light text-dark border">@(asset.Category?.Name ?? "General")</span></td>
                                        <td class="text-muted small">@(asset.Location ?? "Corporate Office")</td>
                                        <td class="pe-4 text-end">
                                            <a asp-controller="Asset" asp-action="Details" asp-route-id="@asset.Id" class="btn btn-sm btn-light border px-2 py-1 rounded-2" title="Details">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- MY ACCOUNT & SHORTCUTS -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-bottom border-light-subtle py-3 px-4">
                    <h4 class="h6 fw-bold text-dark mb-0">My Account Details</h4>
                    <small class="text-muted">Account profile and security shortcuts</small>
                </div>
                <div class="card-body p-4">
                    <ul class="list-unstyled mb-4">
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Full Name</span>
                            <span class="fw-semibold text-dark">@Model.FullName</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Username</span>
                            <span class="fw-semibold text-dark">@Model.Username</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Email Address</span>
                            <span class="fw-semibold text-dark">@Model.Email</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Department</span>
                            <span class="fw-semibold text-dark">@Model.Department</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Employee ID</span>
                            <span class="fw-semibold text-dark">@Model.EmployeeId</span>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span class="text-muted small">Role</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.RoleName</span>
                        </li>
                    </ul>

                    <div class="d-grid gap-2">
                        <a asp-controller="Profile" asp-action="Edit" class="btn btn-outline-primary btn-sm py-2 rounded-2">
                            Edit Profile
                        </a>
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-light border btn-sm py-2 rounded-2">
                            Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
