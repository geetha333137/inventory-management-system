@model DashboardViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@{
    var maxCategoryCount = Model.AssetsByCategory.Any() ? Model.AssetsByCategory.Max(x => x.Value) : 0;
    var maxStatusCount = Model.AssetsByStatus.Any() ? Model.AssetsByStatus.Max(x => x.Value) : 0;
}

<div class="dashboard-page">
    <div class="dashboard-intro">
        <div>
            <span class="dashboard-intro-mark" aria-hidden="true"><i class="bi bi-grid-1x2-fill"></i></span>
            <div>
                <p class="dashboard-eyebrow">Workspace overview</p>
                <p class="dashboard-intro-copy">A clear view of your assets, stock, and recent activity.</p>
            </div>
        </div>
        <span class="dashboard-live"><span></span> Live overview</span>
    </div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="kpi-card teal">
            <a class="dashboard-kpi-link" asp-controller="Asset" asp-action="Index">
                <div class="kpi-label">Total Assets</div>
                <div class="kpi-value">@Model.TotalAssets</div>
            </a>
            <small class="text-muted">Registered inventory items</small>
        </div>
    </div>
    @if (User.IsInRole("Asset Manager"))
    {
        <div class="col-6 col-xl-3">
            <div class="kpi-card blue">
                <a class="dashboard-kpi-link" asp-controller="Users" asp-action="Index">
                    <div class="kpi-label">Total Users</div>
                    <div class="kpi-value">@Model.TotalUsers</div>
                </a>
                <small class="text-muted">People with system access</small>
            </div>
        </div>
    }
    <div class="col-6 col-xl-3">
        <div class="kpi-card amber">
            <a class="dashboard-kpi-link" asp-controller="Inventory" asp-action="Index">
                <div class="kpi-label">Total Inventory</div>
                <div class="kpi-value">@Model.TotalInventoryItems</div>
            </a>
            <small class="text-muted">Tracked stock items</small>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card green">
            <a class="dashboard-kpi-link" asp-controller="Asset" asp-action="Index" asp-route-status="Available">
                <div class="kpi-label">Available</div>
                <div class="kpi-value">@Model.AvailableAssets</div>
            </a>
            <small class="text-muted">Ready for assignment</small>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card blue">
            <a class="dashboard-kpi-link" asp-controller="Asset" asp-action="Index" asp-route-status="Assigned">
                <div class="kpi-label">Assigned</div>
                <div class="kpi-value">@Model.AssignedAssets</div>
            </a>
            <small class="text-muted">Currently in use</small>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card amber">
            <a class="dashboard-kpi-link" asp-controller="Asset" asp-action="Index" asp-route-status="Under Maintenance">
                <div class="kpi-label">Under Maintenance</div>
                <div class="kpi-value">@Model.MaintenanceAssets</div>
            </a>
            <small class="text-muted">Temporarily unavailable</small>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card teal">
            <a class="dashboard-kpi-link" asp-controller="Asset" asp-action="Index" asp-route-activeOnly="true">
                <div class="kpi-label">Active Assets</div>
                <div class="kpi-value">@Model.ActiveAssets</div>
            </a>
            <small class="text-muted">Available, assigned or in repair</small>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card slate">
            <a class="dashboard-kpi-link" asp-controller="Asset" asp-action="Index" asp-route-activeOnly="false">
                <div class="kpi-label">Inactive Assets</div>
                <div class="kpi-value">@Model.InactiveAssets</div>
            </a>
            <small class="text-muted">Damaged, retired or lost</small>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card rose">
            <a class="dashboard-kpi-link" asp-controller="Asset" asp-action="Index" asp-route-status="Retired">
                <div class="kpi-label">Retired</div>
                <div class="kpi-value">@Model.RetiredAssets</div>
            </a>
            <small class="text-muted">Removed from active use</small>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="kpi-card blue">
            <a class="dashboard-kpi-link" asp-controller="Category" asp-action="Index">
                <div class="kpi-label">Categories</div>
                <div class="kpi-value">@Model.CategoryCount</div>
            </a>
            <small class="text-muted">Active asset categories</small>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-7">
        <div class="dashboard-panel h-100">
            <div class="dashboard-panel-header">
                <div>
                    <p class="dashboard-eyebrow">Overview</p>
                    <h5>Operational summary</h5>
                </div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Asset" asp-action="Index">View all</a>
            </div>

            <div class="summary-grid">
                <div class="summary-tile">
                    <span class="summary-label">Available</span>
                    <strong>@Model.AvailableAssets</strong>
                    <small>Ready to assign</small>
                </div>
                <div class="summary-tile">
                    <span class="summary-label">Assigned</span>
                    <strong>@Model.AssignedAssets</strong>
                    <small>Currently in use</small>
                </div>
                <div class="summary-tile">
                    <span class="summary-label">Maintenance</span>
                    <strong>@Model.MaintenanceAssets</strong>
                    <small>Pending service</small>
                </div>
                <div class="summary-tile">
                    <span class="summary-label">Retired</span>
                    <strong>@Model.RetiredAssets</strong>
                    <small>Removed from use</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-5">
        <div class="dashboard-panel h-100">
            <div class="dashboard-panel-header">
                <div>
                    <p class="dashboard-eyebrow">Health</p>
                    <h5>Inventory status</h5>
                </div>
            </div>

            @if (Model.AssetsByStatus.Any())
            {
                @foreach (var status in Model.AssetsByStatus)
                {
                    var width = maxStatusCount > 0 ? (status.Value / (double)maxStatusCount) * 100 : 0;
                    <div class="progress-row">
                        <div class="progress-meta">
                            <span>@status.Label</span>
                            <strong>@status.Value</strong>
                        </div>
                        <div class="progress-track" role="progressbar" aria-label="@status.Label assets" aria-valuenow="@status.Value" aria-valuemin="0" aria-valuemax="@maxStatusCount">
                            <span style="width: @width%"></span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">No status records are available yet.</div>
            }
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-5">
        <div class="dashboard-panel h-100">
            <div class="dashboard-panel-header">
                <div>
                    <p class="dashboard-eyebrow">Distribution</p>
                    <h5>By category</h5>
                </div>
            </div>

            @if (Model.AssetsByCategory.Any())
            {
                @foreach (var category in Model.AssetsByCategory)
                {
                    var width = maxCategoryCount > 0 ? (category.Value / (double)maxCategoryCount) * 100 : 0;
                    <div class="progress-row compact">
                        <div class="progress-meta">
                            <span>@category.Label</span>
                            <strong>@category.Value</strong>
                        </div>
                        <div class="progress-track mini" role="progressbar" aria-label="@category.Label assets" aria-valuenow="@category.Value" aria-valuemin="0" aria-valuemax="@maxCategoryCount">
                            <span style="width: @width%"></span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">No category usage data is available.</div>
            }
        </div>
    </div>

    <div class="col-xl-7">
        <div class="dashboard-panel h-100">
            <div class="dashboard-panel-header">
                <div>
                    <p class="dashboard-eyebrow">Tasks</p>
                    <h5>Management actions</h5>
                </div>
            </div>

            <div class="action-grid">
                <a class="action-link" asp-controller="Asset" asp-action="Create">
                    <span class="action-icon">＋</span>
                    <span>
                        <strong>Add asset</strong>
                        <small>Register a new item</small>
                    </span>
                </a>
                <a class="action-link" asp-controller="Inventory" asp-action="Index">
                    <span class="action-icon">▣</span>
                    <span>
                        <strong>Inventory</strong>
                        <small>Track stock movements</small>
                    </span>
                </a>
                <a class="action-link" asp-controller="Category" asp-action="Index">
                    <span class="action-icon">☰</span>
                    <span>
                        <strong>Categories</strong>
                        <small>Review classification</small>
                    </span>
                </a>
                @if (User.IsInRole("Asset Manager"))
                {
                    <a class="action-link" asp-controller="Users" asp-action="Index">
                        <span class="action-icon">◎</span>
                        <span>
                            <strong>Users</strong>
                            <small>Manage system access</small>
                        </span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Assets</h5>
                <a class="btn btn-sm btn-primary" asp-controller="Asset" asp-action="Create">Add Asset</a>
            </div>
            @if (Model.RecentAssets.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var asset in Model.RecentAssets)
                        {
                            <tr>
                                <td class="fw-semibold">@asset.AssetCode</td>
                                <td>
                                    <a asp-controller="Asset" asp-action="Details" asp-route-id="@asset.Id">@asset.AssetName</a>
                                </td>
                                <td>@(asset.Category?.Name ?? "—")</td>
                                <td><partial name="_AssetStatusBadge" model="asset.Status" /></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">No assets have been registered yet.</div>
            }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel h-100">
            <h5 class="fw-bold mb-3">Recent Inventory Activities</h5>
            @if (Model.RecentActivities.Any())
            {
                @foreach (var item in Model.RecentActivities)
                {
                    <div class="activity-item">
                        <span class="activity-dot"></span>
                        <div>
                            <div class="fw-semibold">@item.Action · @item.EntityName</div>
                            <div class="small text-muted">@item.Description</div>
                            <div class="small text-muted mt-1">@item.PerformedBy · @item.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">No recent activity yet. Add or update an asset to see the audit trail.</div>
            }
        </div>
    </div>
</div>

</div>
