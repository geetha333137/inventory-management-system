@model List<InventoryManagementSystem.Models.InventoryItem>

@{
    ViewData["Title"] = "Inventory";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-3">
            <div>
                <p class="text-uppercase text-secondary mb-1">Inventory</p>
                <h1 class="mb-0">Inventory Management</h1>
            </div>
            <a asp-action="Create" class="btn btn-primary">Add Item</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search inventory item or category..." />
                <button type="submit" class="btn btn-secondary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center py-4">No inventory items found.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Category</td>
                                <td>@item.Quantity</td>
                                <td>$@item.Price</td>
                                <td>
                                    @if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning text-dark">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Healthy</span>
                                    }
                                </td>
                                <td>@item.UpdatedAt.ToLocalTime().ToString("dd-MM-yyyy")</td>
                                <td>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this item?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
