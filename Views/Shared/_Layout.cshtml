<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand-box">
                <span class="brand-mark">IM</span>
                <div>
                    <div class="brand-name">Inventory</div>
                    <small>Management</small>
                </div>
            </div>

            <nav class="nav flex-column mt-4">
                <a class="nav-link active" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Users" asp-action="Index">Users</a>
                <a class="nav-link" asp-controller="Inventory" asp-action="Index">Inventory</a>
                <a class="nav-link" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Reports</a>
                <a class="nav-link" asp-controller="Home" asp-action="Index">Settings</a>
            </nav>
        </aside>

        <div class="main-panel">
            <header class="topbar">
                <div>
                    <h3 class="mb-0">Inventory Dashboard</h3>
                </div>
                <div class="topbar-actions">
                    <span class="badge bg-success">System Active</span>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
