@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockSphere Inventory</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var isManager = User.IsInRole("Asset Manager");
        var isExecutive = User.IsInRole("Inventory Executive");
        var isStandardUser = !isManager && !isExecutive;
        var userRoleName = isManager ? "Asset Manager" : (isExecutive ? "Inventory Executive" : "User");
        var userFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "User";
        var userInitial = string.IsNullOrWhiteSpace(userFullName) ? "U" : userFullName.Substring(0, 1).ToUpper();

        <div class="authenticated-shell">
            <!-- MODERN APP SIDEBAR -->
            <aside class="app-sidebar" id="appSidebar">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Dashboard">
                    <span class="sidebar-brand-mark">SS</span>
                    <span>
                        <strong>StockSphere</strong>
                        <small>Inventory Platform</small>
                    </span>
                </a>

                <nav class="sidebar-navigation" aria-label="Application navigation">
                    @if (isStandardUser)
                    {
                        <span class="sidebar-section-label">My Workspace</span>
                        <a asp-controller="Dashboard" asp-action="UserDashboard">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                                </svg>
                            </span>
                            <span>My Dashboard</span>
                        </a>
                        <a asp-controller="Asset" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </span>
                            <span>Company Assets</span>
                        </a>
                        <a asp-controller="Category" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                </svg>
                            </span>
                            <span>Categories</span>
                        </a>
                        <a asp-controller="Inventory" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                            </span>
                            <span>Inventory</span>
                        </a>
                    }
                    else
                    {
                        <span class="sidebar-section-label">Workspace</span>
                        <a asp-controller="Dashboard" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                                </svg>
                            </span>
                            <span>Dashboard</span>
                        </a>
                        <a asp-controller="Asset" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </span>
                            <span>Assets</span>
                        </a>
                        <a asp-controller="Category" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                </svg>
                            </span>
                            <span>Categories</span>
                        </a>
                        <a asp-controller="Inventory" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                            </span>
                            <span>Inventory</span>
                        </a>
                        <a asp-controller="AssetTracking" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                                </svg>
                            </span>
                            <span>Asset Tracking</span>
                        </a>
                        @if (isManager || isExecutive)
                        {
                            <a asp-controller="AssetAssignments" asp-action="Index">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                    </svg>
                                </span>
                                <span>Assignments</span>
                            </a>
                        }
                        <a asp-controller="Reports" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                            </span>
                            <span>Reports</span>
                        </a>
                    }

                    @if (isManager || isExecutive)
                    {
                        <span class="sidebar-section-label">Administration</span>
                        @if (isManager)
                        {
                            <a asp-controller="Users" asp-action="Index">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                    </svg>
                                </span>
                                <span>Users</span>
                            </a>
                        }
                        <a asp-controller="Organisation" asp-action="Index">
                            <span class="sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                </svg>
                            </span>
                            <span>Organisation</span>
                        </a>
                        @if (isManager)
                        {
                            <a asp-controller="Suppliers" asp-action="Index">
                                <span class="sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                                    </svg>
                                </span>
                                <span>Suppliers</span>
                            </a>
                        }
                    }

                    <span class="sidebar-section-label">Account</span>
                    <a asp-controller="Profile" asp-action="Index">
                        <span class="sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </span>
                        <span>My Profile</span>
                    </a>
                    <a asp-controller="Account" asp-action="ChangePassword">
                        <span class="sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </span>
                        <span>Security</span>
                    </a>
                </nav>

                <!-- USER INFO & LOGOUT -->
                <div class="sidebar-account">
                    <div class="sidebar-user-card mb-3 p-2 rounded-2 bg-dark-subtle d-flex align-items-center gap-2">
                        <div class="user-avatar-sm">
                            @userInitial
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold text-white small text-truncate">@userFullName</div>
                            <div class="badge-role-pill">@userRoleName</div>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-logout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span>Sign Out</span>
                        </button>
                    </form>
                </div>
            </aside>

            <!-- MAIN CONTENT AREA -->
            <div class="app-main">
                <header class="app-topbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="sidebar-toggle"
                                type="button"
                                onclick="toggleSidebar()"
                                aria-controls="appSidebar"
                                aria-expanded="false"
                                title="Toggle navigation">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>

                        <div>
                            <p class="app-breadcrumb mb-0">
                                StockSphere Workspace &bull; <span class="text-primary fw-medium">@userRoleName</span>
                            </p>
                            <h1 class="h4 fw-bold text-dark mb-0">
                                @ViewData["Title"]
                            </h1>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <span class="badge role-topbar-badge">
                            @userRoleName
                        </span>

                        @if (isManager || isExecutive)
                        {
                            <partial name="_NotificationBell" />
                        }

                        <a asp-controller="Profile" asp-action="Index" class="topbar-user-pill d-none d-sm-flex align-items-center gap-2 text-decoration-none" title="View Profile">
                            <div class="user-avatar-sm">@userInitial</div>
                            <span class="small fw-semibold text-dark">@userFullName</span>
                        </a>
                    </div>
                </header>

                <main role="main" class="app-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- ================= PUBLIC NAVBAR ================= -->
        <header>
            <nav class="main-navbar">
                <div class="navbar-container">
                    <a class="brand-logo" asp-controller="Home" asp-action="Index">
                        <div class="brand-icon">📦</div>
                        <div class="brand-text">
                            <span>StockSphere</span>
                            <span>Inventory Management</span>
                        </div>
                    </a>

                    <button class="mobile-menu-button" type="button" onclick="toggleMenu()" title="Toggle Menu">
                        ☰
                    </button>

                    <div class="main-navigation" id="mainNavigation">
                        <a href="/#features">Features</a>
                        <a href="/#resources">Resources</a>
                        <a href="/#about">About Us</a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-sm btn-outline-primary ms-2">Go to Dashboard</a>
                        }
                        else
                        {
                            <a class="navbar-login" asp-controller="Account" asp-action="Login">
                                <span>👤</span>
                                <span>Sign In</span>
                            </a>
                        }
                    </div>
                </div>
            </nav>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="main-footer">
            <div class="footer-container">
                <div>© 2026 StockSphere Inventory Management System</div>
                <div>Minimal, reliable, and secure enterprise asset management.</div>
            </div>
        </footer>
    }

    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            window.notificationConfig = {
                urls: {
                    getAll: '@Url.Action("GetAll", "Notifications")',
                    create: '@Url.Action("Create", "Notifications")',
                    markAsRead: '@Url.Action("MarkAsRead", "Notifications")',
                    markAllAsRead: '@Url.Action("MarkAllAsRead", "Notifications")',
                    delete: '@Url.Action("Delete", "Notifications")',
                    clearAll: '@Url.Action("ClearAll", "Notifications")'
                },
                emailJs: {
                    publicKey: '@Configuration["EmailJS:PublicKey"]',
                    serviceId: '@Configuration["EmailJS:ServiceId"]',
                    templateId: '@Configuration["EmailJS:TemplateId"]',
                    defaultRecipientEmail: '@Configuration["EmailJS:DefaultRecipientEmail"]'
                }
            };
        </script>
        <script src="~/js/emailjs.js" asp-append-version="true"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }

    <script>
        function toggleMenu() {
            const menu = document.getElementById("mainNavigation");
            if (menu) menu.classList.toggle("show");
        }

        function toggleSidebar() {
            const sidebar = document.getElementById("appSidebar");
            const button = document.querySelector(".sidebar-toggle");
            if (!sidebar || !button) return;
            const isOpen = sidebar.classList.toggle("is-open");
            button.setAttribute("aria-expanded", isOpen.toString());
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>