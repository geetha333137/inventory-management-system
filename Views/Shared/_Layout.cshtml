@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <!-- Notification-only CSS. -->
    <link rel="stylesheet"
          href="~/css/notification.css"
          asp-append-version="true" />
</head>

<body>

    <!--
        The current Razor view supplies the ONLY visible UI.
        There is no shared application header.
    -->
    @RenderBody()

    <!--
        MVC generates controller URLs.
        EmailJS configuration comes from appsettings.json.
    -->
    <script>
        window.notificationConfig = {

            urls: {

                getAll:
                    '@Url.Action("GetAll", "Notifications")',

                create:
                    '@Url.Action("Create", "Notifications")',

                markAsRead:
                    '@Url.Action("MarkAsRead", "Notifications")',

                markAllAsRead:
                    '@Url.Action("MarkAllAsRead", "Notifications")',

                delete:
                    '@Url.Action("Delete", "Notifications")',

                clearAll:
                    '@Url.Action("ClearAll", "Notifications")'
            },

            emailJs: {

                publicKey:
                    '@Configuration["EmailJS:PublicKey"]',

                serviceId:
                    '@Configuration["EmailJS:ServiceId"]',

                templateId:
                    '@Configuration["EmailJS:TemplateId"]',

                defaultRecipientEmail:
                    '@Configuration["EmailJS:DefaultRecipientEmail"]'
            }
        };
    </script>

    <!-- EmailJS is loaded dynamically by emailjs.js. -->
    <script src="~/js/emailjs.js"
            asp-append-version="true"></script>

    <!-- Notification button and panel logic. -->
    <script src="~/js/notifications.js"
            asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
