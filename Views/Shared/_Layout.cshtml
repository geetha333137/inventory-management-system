<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <div class="brand">
                <span class="brand-mark"><i class="bi bi-box-seam"></i></span>
                <div>
                    <div class="brand-name">IMS</div>
                    <div class="brand-tag">Inventory System</div>
                </div>
            </div>

            <div class="sidebar-label">Main</div>
            <nav class="sidebar-nav">
                <a class="nav-link @(currentController == "Dashboard" || currentController == "Home" ? "active" : "")"
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(currentController == "Asset" ? "active" : "")"
                   asp-controller="Asset" asp-action="Index">
                    <i class="bi bi-boxes"></i> Inventory
                </a>
                <a class="nav-link @(currentController == "Category" ? "active" : "")"
                   asp-controller="Category" asp-action="Index">
                    <i class="bi bi-tags"></i> Categories
                </a>
            </nav>

            <div class="sidebar-label">Management</div>
            <nav class="sidebar-nav">
                <a class="nav-link muted" asp-controller="Home" asp-action="ComingSoon">
                    <i class="bi bi-people"></i> Users
                </a>
                <a class="nav-link muted" asp-controller="Home" asp-action="ComingSoon">
                    <i class="bi bi-shield-lock"></i> Roles
                </a>
                <a class="nav-link muted" asp-controller="Home" asp-action="ComingSoon">
                    <i class="bi bi-building"></i> Organisation
                </a>
            </nav>

            <div class="sidebar-label">Insights</div>
            <nav class="sidebar-nav">
                <a class="nav-link muted" asp-controller="Home" asp-action="ComingSoon">
                    <i class="bi bi-graph-up"></i> Reports
                </a>
                <a class="nav-link muted" asp-controller="Home" asp-action="ComingSoon">
                    <i class="bi bi-bell"></i> Notifications
                </a>
            </nav>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button class="sidebar-toggle" type="button" id="sidebarToggle" aria-label="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">
                    <h1>@(ViewData["Title"] ?? "Inventory Management")</h1>
                    <p>@(ViewData["PageSubtitle"] ?? "Inventory Management System")</p>
                </div>
                <div class="topbar-user">
                    <span class="user-chip">
                        <i class="bi bi-person-circle"></i>
                        Inventory User
                    </span>
                </div>
            </header>

            <main class="page-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById("sidebarToggle")?.addEventListener("click", function () {
            document.body.classList.toggle("sidebar-open");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
