@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

﻿<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Inventory Management System
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/notification.css"
          asp-append-version="true" />
</head>

<body>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="authenticated-shell">
            <aside class="app-sidebar" id="appSidebar">
                <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                    <span class="sidebar-brand-mark">IM</span>
                    <span>
                        <strong>Inventory</strong>
                        <small>Management System</small>
                    </span>
                </a>

                <nav class="sidebar-navigation" aria-label="Application navigation">
                    <span class="sidebar-section-label">Workspace</span>
                    <a asp-controller="Dashboard" asp-action="Index">
                        <span class="sidebar-icon">&#9632;</span>
                        Dashboard
                    </a>
                    <a asp-controller="Inventory" asp-action="Index">
                        <span class="sidebar-icon">&#9633;</span>
                        Inventory
                    </a>
                    <a asp-controller="Asset" asp-action="Index">
                        <span class="sidebar-icon">&#9645;</span>
                        Assets
                    </a>
                    <a asp-controller="Category" asp-action="Index">
                        <span class="sidebar-icon">&#9776;</span>
                        Categories
                    </a>

                    @if (User.IsInRole("Asset Manager"))
                    {
                        <span class="sidebar-section-label">Administration</span>
                        <a asp-controller="Users" asp-action="Index">
                            <span class="sidebar-icon">&#9673;</span>
                            Users
                        </a>
                        <a asp-controller="Organisation" asp-action="Index">
                            <span class="sidebar-icon">&#9638;</span>
                            Organisation
                        </a>
                    }
                </nav>

                <div class="sidebar-account">
                    <div class="sidebar-user">
                        <span class="sidebar-avatar">@User.Identity?.Name?.Substring(0, 1).ToUpperInvariant()</span>
                        <span>
                            <strong>@User.Identity?.Name</strong>
                            <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                        </span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-logout">Log out</button>
                    </form>
                </div>
            </aside>

            <div class="app-main">
                <header class="app-topbar">
                    <button class="sidebar-toggle" type="button" onclick="toggleSidebar()" aria-controls="appSidebar" aria-expanded="false">
                        &#9776;
                    </button>
                    <div>
                        <p class="app-breadcrumb">Inventory workspace</p>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                    <partial name="_NotificationBell" />
                </header>

                <main role="main" class="app-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- ================= PUBLIC NAVBAR ================= -->

        <header>

        <nav class="main-navbar">

            <div class="navbar-container">

                <!-- LOGO / PROJECT NAME -->

                <a class="brand-logo"
                   asp-controller="Home"
                   asp-action="Index">

                    <div class="brand-icon">
                        📋
                    </div>

                    <div class="brand-text">
                        <span>Inventory</span>
                        <span>Management System</span>
                    </div>

                </a>


                <!-- MOBILE MENU BUTTON -->

                <button class="mobile-menu-button"
                        type="button"
                        onclick="toggleMenu()">

                    ☰

                </button>


                <!-- NAVIGATION -->

                <div class="main-navigation" id="mainNavigation">

                    <a href="/#features">
                        Features
                    </a>

                    <a href="/#resources">
                        Resources
                    </a>

                    <a href="/#about">
                        About Us
                    </a>

                    <span class="search-icon">
                        🔍
                    </span>


                    <!-- LOGIN / LOGOUT -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              style="display:inline;">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="navbar-login">

                                <span>👤</span>
                                Logout

                            </button>

                        </form>
                    }
                    else
                    {
                        <a class="navbar-login"
                           asp-controller="Account"
                           asp-action="Login">

                            <span>👤</span>
                            Login

                        </a>
                    }

                </div>

            </div>

        </nav>

        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="main-footer">
            <div class="footer-container">
                <div>© 2026 Inventory Management System</div>
                <div>Manage your inventory efficiently and securely.</div>
            </div>
        </footer>
    }


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script>
        window.notificationConfig = {
            urls: {
                getAll: '@Url.Action("GetAll", "Notifications")',
                create: '@Url.Action("Create", "Notifications")',
                markAsRead: '@Url.Action("MarkAsRead", "Notifications")',
                markAllAsRead: '@Url.Action("MarkAllAsRead", "Notifications")',
                delete: '@Url.Action("Delete", "Notifications")',
                clearAll: '@Url.Action("ClearAll", "Notifications")'
            },
            emailJs: {
                publicKey: '@Configuration["EmailJS:PublicKey"]',
                serviceId: '@Configuration["EmailJS:ServiceId"]',
                templateId: '@Configuration["EmailJS:TemplateId"]',
                defaultRecipientEmail: '@Configuration["EmailJS:DefaultRecipientEmail"]'
            }
        };
    </script>

    <script src="~/js/emailjs.js"
            asp-append-version="true"></script>

    <script src="~/js/notifications.js"
            asp-append-version="true"></script>

    <script>

        function toggleMenu() {

            const menu =
                document.getElementById("mainNavigation");

            menu.classList.toggle("show");

        }

        function toggleSidebar() {
            const sidebar = document.getElementById("appSidebar");
            const button = document.querySelector(".sidebar-toggle");
            if (!sidebar || !button) return;

            const isOpen = sidebar.classList.toggle("is-open");
            button.setAttribute("aria-expanded", isOpen.toString());
        }

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
