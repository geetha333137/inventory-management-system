@model List<InventoryManagementSystem.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-3">
            <div>
                <p class="text-uppercase text-secondary mb-1">Suppliers</p>
                <h1 class="mb-0">Supplier Management</h1>
            </div>
            <a asp-action="Create" class="btn btn-primary">Add Supplier</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <form asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search supplier name, email or phone..." />
                <button type="submit" class="btn btn-secondary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center py-4">No suppliers found.</td></tr>
                    }
                    else
                    {
                        foreach (var supplier in Model)
                        {
                            <tr>
                                <td>@supplier.Name</td>
                                <td>@supplier.Email</td>
                                <td>@supplier.PhoneNumber</td>
                                <td>@supplier.Address</td>
                                <td>
                                    <form asp-action="Delete" asp-route-id="@supplier.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this supplier?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
