@model InventoryManagementSystem.ViewModels.LoginViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Sign In";
}

<div class="auth-page">
    <section class="auth-intro">
        <div class="d-inline-flex align-items-center gap-2 mb-3">
            <span class="fs-4">📦</span>
            <span class="fw-bold tracking-wider text-uppercase small text-primary">StockSphere Platform</span>
        </div>

        <h1 class="display-6 fw-bold text-dark mb-3">Keep every asset in view.</h1>

        <p class="intro-copy text-secondary fs-5 mb-4">
            A unified workspace for managing inventory, hardware allocations, and operations across your organisation.
        </p>

    </section>

    <section class="auth-card">
        <div class="auth-card-header mb-4">
            <h2 class="h3 fw-bold text-dark mb-1">Welcome back</h2>
            <p class="text-muted small mb-0">Sign in with your username or company email</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger rounded-3 py-2 px-3 small mb-3">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="mb-0">@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="form-field mb-3">
                <label asp-for="UsernameOrEmail" class="form-label fw-semibold text-secondary small">
                    Username or Email
                </label>
                <input asp-for="UsernameOrEmail" id="usernameInput" class="form-control py-2" placeholder="admin or employee or user" required autofocus />
                <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
            </div>

            <div class="form-field mb-3">
                <label asp-for="Password" class="form-label fw-semibold text-secondary small">
                    Password
                </label>
                <input asp-for="Password" id="passwordInput" type="password" class="form-control py-2" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                    <label asp-for="RememberMe" class="form-check-label text-secondary small" for="rememberMe">
                        Keep me signed in
                    </label>
                </div>

                <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none small text-primary fw-medium">
                    Forgot password?
                </a>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-2 shadow-sm">
                Sign In
            </button>
        </form>

        <div class="mt-4 pt-3 border-top text-center">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">
                &larr; Back to Public Home
            </a>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        function fillLogin(user, pass) {
            document.getElementById('usernameInput').value = user;
            document.getElementById('passwordInput').value = pass;
        }
    </script>
}