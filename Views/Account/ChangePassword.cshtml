@model InventoryManagementSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="content-card">
    <p class="eyebrow">Security</p>
    <h1>Change password</h1>
    <p class="helper-text">Update your password to keep your inventory workspace secure.</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<form asp-controller="Account"
      asp-action="ChangePassword"
      method="post">

    @Html.AntiForgeryToken()

    <div class="form-field">
        <label asp-for="CurrentPassword">
            Current Password
        </label>
        <input asp-for="CurrentPassword"
               type="password" />

        <span asp-validation-for="CurrentPassword"
             ></span>
    </div>

    <div class="form-field">
        <label asp-for="NewPassword">
            New Password
        </label>
        <input asp-for="NewPassword"
               type="password" />

        <span asp-validation-for="NewPassword"
             ></span>
    </div>

    <div class="form-field">
        <label asp-for="ConfirmPassword">
            Confirm New Password
        </label>
        <input asp-for="ConfirmPassword"
               type="password" />

        <span asp-validation-for="ConfirmPassword"
             ></span>
    </div>

    <button type="submit">
        Change Password
    </button>
</form>

<div class="form-links">
    <a asp-controller="Home" asp-action="Dashboard">Back to dashboard</a>
</div>
</div>