@model InventoryManagementSystem.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="container mt-4">

    <h1>User Details</h1>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Username
        </dt>

        <dd class="col-sm-9">
            @Model.Username
        </dd>

        <dt class="col-sm-3">
            Full Name
        </dt>

        <dd class="col-sm-9">
            @Model.FullName
        </dd>

        <dt class="col-sm-3">
            Email
        </dt>

        <dd class="col-sm-9">
            @Model.Email
        </dd>

        <dt class="col-sm-3">
            Phone
        </dt>

        <dd class="col-sm-9">
            @Model.PhoneNumber
        </dd>

        <dt class="col-sm-3">
            Role
        </dt>

        <dd class="col-sm-9">
            @Model.Role?.Name
        </dd>

        <dt class="col-sm-3">
            Status
        </dt>

        <dd class="col-sm-9">

            @if (Model.IsActive)
            {
                <span class="badge bg-success">
                    Active
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    Inactive
                </span>
            }

        </dd>

        <dt class="col-sm-3">
            Created
        </dt>

        <dd class="col-sm-9">
            @Model.CreatedAt.ToLocalTime()
        </dd>

    </dl>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Users
    </a>

</div>